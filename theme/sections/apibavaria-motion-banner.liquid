{% comment %}
  Section contract.
  Brand banner with the animated API Bavaria honeycomb motion graphic (drawing comb,
  glowing honey cells, flying bees) next to a short message and an optional button.
  Copy, link, colour scheme and bees are merchant-controlled; the graphic itself lives
  in snippets/apibavaria-motion-hive.liquid.
  @example
  <!-- Theme editor: Add section > "API Bavaria Motion-Banner" -->
{% endcomment %}

{%- liquid
  assign heading_id = 'apb-motion-banner-title-' | append: section.id
-%}

<section
  class="apb-motion-banner apb-motion-banner--{{ section.settings.scheme }}"
  {% if section.settings.heading != blank %}
    aria-labelledby="{{ heading_id }}"
  {% else %}
    aria-label="API Bavaria"
  {% endif %}
>
  <div class="apb-motion-banner__inner">
    <div class="apb-motion-banner__copy">
      {%- if section.settings.kicker != blank -%}
        <p class="apb-motion-banner__kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 id="{{ heading_id }}" class="apb-motion-banner__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="apb-motion-banner__text">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <p class="apb-motion-banner__actions">
          <a class="apb-motion-banner__button" href="{{ section.settings.button_link }}">
            {{- section.settings.button_label | escape -}}
            <span aria-hidden="true">→</span>
          </a>
        </p>
      {%- endif -%}
    </div>

    {%- liquid
      assign hive_variant = 'hero'
      if section.settings.scheme == 'dark'
        assign hive_variant = 'banner'
      endif
      render 'apibavaria-motion-hive', variant: hive_variant, bees: section.settings.show_bees, class: 'apb-motion-banner__hive'
    -%}
  </div>
</section>

{% stylesheet %}
  .apb-motion-banner {
    --apb-banner-bg: #3f4a1f;
    --apb-banner-fg: #fff;
    --apb-banner-muted: #dde5c4;
    --apb-banner-accent: #c6d29d;
    --apb-banner-line: rgb(215 226 220 / 0.28);

    width: min(100% - 32px, 900px);
    margin: 0 auto clamp(56px, 7vw, 96px);
  }

  .apb-motion-banner *,
  .apb-motion-banner *::before,
  .apb-motion-banner *::after {
    box-sizing: border-box;
  }

  .apb-motion-banner--light {
    --apb-banner-bg: #f5f7ec;
    --apb-banner-fg: #3f4a1f;
    --apb-banner-muted: #5f6c39;
    --apb-banner-accent: #6b7d32;
    --apb-banner-line: #d7debb;
  }

  .apb-motion-banner__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(16px, 3vw, 40px);
    min-height: 320px;
    padding: clamp(26px, 4vw, 48px);
    overflow: hidden;
    border: 1px solid var(--apb-banner-line);
    background: var(--apb-banner-bg);
    color: var(--apb-banner-fg);
    isolation: isolate;
  }

  .apb-motion-banner__copy {
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .apb-motion-banner__kicker {
    margin: 0 0 10px;
    color: var(--apb-banner-accent);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .apb-motion-banner__heading {
    margin: 0;
    color: inherit;
    font-size: clamp(1.7rem, 3vw, 2.6rem);
    line-height: 1;
    letter-spacing: -0.045em;
    overflow-wrap: anywhere;
  }

  .apb-motion-banner__text {
    max-width: 42ch;
    margin-top: 14px;
    color: var(--apb-banner-muted);
    font-size: 0.86rem;
    line-height: 1.6;
  }

  .apb-motion-banner__text > :first-child {
    margin-top: 0;
  }

  .apb-motion-banner__text > :last-child {
    margin-bottom: 0;
  }

  .apb-motion-banner__actions {
    margin: 22px 0 0;
  }

  .apb-motion-banner__button {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    gap: 10px;
    padding: 11px 19px;
    border: 1px solid var(--apb-banner-accent);
    background: var(--apb-banner-accent);
    color: var(--apb-banner-bg);
    font-size: 0.84rem;
    font-weight: 750;
    text-decoration: none;
    transition: background-color var(--animation-speed-slow, 0.2s) ease, color var(--animation-speed-slow, 0.2s) ease;
  }

  .apb-motion-banner__button:hover {
    background: transparent;
    color: var(--apb-banner-accent);
  }

  .apb-motion-banner__button:focus-visible {
    outline: 3px solid #a1ad78;
    outline-offset: 3px;
  }

  .apb-motion-banner__button span {
    transition: transform var(--animation-speed-slow, 0.2s) var(--ease-out-cubic, ease);
  }

  .apb-motion-banner__button:hover span {
    transform: translateX(4px);
  }

  .apb-motion-banner__hive {
    align-self: stretch;
    min-height: 240px;
    margin-block: -12px;
  }

  @media (max-width: 989px) {
    .apb-motion-banner {
      width: min(100% - 32px, 420px);
    }

    .apb-motion-banner__inner {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .apb-motion-banner__hive {
      order: -1;
      height: 200px;
      min-height: 0;
      margin: -10px 0 0;
    }
  }

  @media (max-width: 749px) {
    .apb-motion-banner {
      width: min(100% - 24px, 300px);
    }

    .apb-motion-banner__inner {
      padding: 20px 18px 24px;
    }

    .apb-motion-banner__hive {
      height: 160px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .apb-motion-banner__button,
    .apb-motion-banner__button span {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "API Bavaria Motion-Banner",
  "tag": "div",
  "class": "apb-motion-banner-section",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Farbschema",
      "options": [
        { "value": "dark", "label": "Dunkelgrün" },
        { "value": "light", "label": "Hell" }
      ],
      "default": "dark"
    },
    {
      "type": "checkbox",
      "id": "show_bees",
      "label": "Fliegende Bienen anzeigen",
      "default": true
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Überzeile",
      "default": "Aus der Praxis für die Praxis"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Imkereibedarf, der mitdenkt."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Ausgewählte Produkte für Fütterung, Wabenbau und Honigernte – zusammengestellt für den Einsatz am Bienenvolk.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button-Text",
      "default": "Sortiment entdecken"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button-Link",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "API Bavaria Motion-Banner"
    }
  ]
}
{% endschema %}
