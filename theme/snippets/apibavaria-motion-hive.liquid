{% stylesheet %}
  .apb-hive {
    /* API Bavaria CI palette only */
    --apb-hive-stroke: #6b7d32;
    --apb-hive-honey: #c6d29d;
    --apb-hive-bee-body: #6b7d32;
    --apb-hive-bee-stripe: #e7ecd4;
    --apb-hive-bee-dark: #3f4a1f;
    --apb-hive-wing: rgb(255 255 255 / 0.85);
    --apb-hive-trail: rgb(107 125 50 / 0.22);

    position: relative;
    pointer-events: none;
    user-select: none;
  }

  .apb-hive--banner {
    --apb-hive-stroke: #cfdaa9;
    --apb-hive-honey: #c6d29d;
    --apb-hive-bee-body: #c6d29d;
    --apb-hive-bee-stripe: #3f4a1f;
    --apb-hive-bee-dark: #f5f7ec;
    --apb-hive-trail: rgb(207 218 169 / 0.2);
    --apb-hive-wing: rgb(255 255 255 / 0.7);
  }

  .apb-hive__svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .apb-hive__cell {
    fill: transparent;
    stroke: var(--apb-hive-stroke);
    stroke-width: 1.4;
    stroke-linejoin: miter;
    opacity: calc(var(--o, 1) * 0.55);
  }

  .apb-hive--banner .apb-hive__cell {
    opacity: calc(var(--o, 1) * 0.75);
  }

  .apb-hive__cell--honey {
    fill: var(--apb-hive-honey);
    fill-opacity: 0.32;
  }

  .apb-hive__trails path {
    fill: none;
    stroke: var(--apb-hive-trail);
    stroke-width: 1;
    stroke-dasharray: 2 7;
    vector-effect: non-scaling-stroke;
  }

  .apb-bee__body {
    fill: var(--apb-hive-bee-body);
  }

  .apb-bee__stripes {
    fill: none;
    stroke: var(--apb-hive-bee-stripe);
    stroke-width: 2.4;
  }

  .apb-bee__head {
    fill: var(--apb-hive-bee-dark);
  }

  .apb-bee__wing {
    fill: var(--apb-hive-wing);
    stroke: var(--apb-hive-stroke);
    stroke-width: 0.6;
    stroke-opacity: 0.6;
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .apb-hive__cell {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: apb-hive-draw 1.1s var(--animation-timing-fade-in, cubic-bezier(0.16, 1, 0.3, 1)) forwards;
      animation-delay: calc(var(--i, 0) * 45ms + 150ms);
    }

    .apb-hive__cell--honey {
      fill-opacity: 0;
      animation:
        apb-hive-draw 1.1s var(--animation-timing-fade-in, cubic-bezier(0.16, 1, 0.3, 1)) forwards,
        apb-hive-honey 5.5s ease-in-out infinite;
      animation-delay: calc(var(--i, 0) * 45ms + 150ms), calc(var(--i, 0) * 45ms + 1.4s);
    }

    .apb-hive__trails {
      opacity: 0;
      animation: apb-hive-fade 1.2s ease 1.6s forwards;
    }

    .apb-hive__bees {
      opacity: 0;
      animation: apb-hive-fade 0.8s ease 1.8s forwards;
    }

    .apb-bee__wing {
      animation: apb-bee-flap 90ms linear infinite alternate;
    }

    .apb-bee__wing--back {
      animation-delay: -45ms;
    }

    .apb-bee__inner {
      animation: apb-bee-hover 1.6s ease-in-out infinite alternate;
    }

    .apb-hive.is-paused * {
      animation-play-state: paused !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .apb-hive__bees,
    .apb-hive__trails {
      display: none;
    }
  }

  @keyframes apb-hive-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes apb-hive-honey {
    0%,
    100% {
      fill-opacity: 0.12;
    }

    50% {
      fill-opacity: 0.45;
    }
  }

  @keyframes apb-hive-fade {
    to {
      opacity: 1;
    }
  }

  @keyframes apb-bee-flap {
    to {
      transform: scaleY(0.35);
    }
  }

  @keyframes apb-bee-hover {
    to {
      transform: translateY(-3px);
    }
  }
{% endstylesheet %}
