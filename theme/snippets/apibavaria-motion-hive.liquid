{%- doc -%}
  Renders the decorative API Bavaria honeycomb motion graphic: hexagon cells that draw
  themselves in, a few honey cells that fill and glow, and optional bees flying loops
  across the comb. Purely decorative (aria-hidden). Motion stops under
  `prefers-reduced-motion: reduce`, and `assets/apibavaria-motion.js` pauses it while
  it is off screen.

  @param {string} [variant] - 'hero' (light background, default) or 'banner' (dark background)
  @param {boolean} [bees] - Render the flying bees. Defaults to true.
  @param {string} [class] - Extra classes for positioning by the caller

  @example
  {% render 'apibavaria-motion-hive', variant: 'hero', bees: true, class: 'apbf-hero__hive' %}
{%- enddoc -%}

{%- liquid
  assign hive_variant = variant | default: 'hero'
  assign show_bees = true
  if bees == false
    assign show_bees = false
  endif
-%}

